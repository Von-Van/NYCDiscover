# Shared local defaults
FIXTURE_MODE=true
FIXTURE_WEATHER=clear
NYC_DISCOVER_USER_AGENT=NYCDiscover/0.1 (contact: you@example.com)
DATABASE_URL=postgresql://nycdiscover:nycdiscover@localhost:5432/nycdiscover
SHARE_SIGNING_SECRET=
REQUEST_HASH_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Live provider endpoints and credentials
NYC_EVENT_CALENDAR_KEY=
NYC_EVENT_CALENDAR_URL=https://api.nyc.gov/calendar/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NWS_URL=https://api.weather.gov

# Web: split local development calls FastAPI directly.
# Vercel preview deployments must override this with /api.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_DEMO_FALLBACK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Hosted Playwright only. Keep this in CI/provider secrets, never in source control.
VERCEL_AUTOMATION_BYPASS_SECRET=
