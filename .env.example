# Shared
FIXTURE_MODE=true
FIXTURE_WEATHER=clear
NYC_DISCOVER_USER_AGENT=NYCDiscover/0.1 (contact: you@example.com)
DATABASE_URL=postgresql://nycdiscover:nycdiscover@localhost:5432/nycdiscover

# Live provider endpoints and credentials
NYC_EVENT_CALENDAR_KEY=
NYC_EVENT_CALENDAR_URL=https://api.nyc.gov/calendar/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NWS_URL=https://api.weather.gov

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_DEMO_FALLBACK=true

